{
  "name": "dashboard-construct0r",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c teal,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx server/index.ts",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "build": "tsc -b && vite build && npm run build:viewer",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "export:sample": "npm run build:viewer && node scripts/export-sample.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "express": "^5.3.0",
    "mssql": "^12.7.13",
    "multer": "^2.5.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "uuid": "^14.0.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-grid-layout": "^1.3.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
